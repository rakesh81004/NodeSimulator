PORT=3001

# MySQL. For local dev, a MySQL server running on this PC. For a Netlify (or
# any serverless) deploy, this must instead point at a real hosted MySQL
# database -- see NETLIFY_DEPLOY.md for step-by-step provider setup.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=node_simulator

# Set to "true" for a managed/cloud MySQL host that requires TLS (most do).
# Leave unset for a plain local MySQL install.
MYSQL_SSL=false
# Only needed if MYSQL_SSL=true and the host's certificate isn't in the
# Node.js trust store (rare) -- set to "false" to skip verifying it.
# MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Max simultaneous connections per pool instance. Lower this (e.g. 2-3) on
# serverless, where many function instances can each hold their own pool.
MYSQL_CONNECTION_LIMIT=10

# Secret used to sign login sessions (JWTs). Set this to a long random string
# in every real environment -- anyone who knows it can forge a valid login.
JWT_SECRET=replace_with_a_long_random_string
