PORT=3001

# MySQL on this PC (keep MySQL running — this is where data lives)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=node_simulator

# Secret used to sign login sessions (JWTs). Set this to a long random string
# in every real environment -- anyone who knows it can forge a valid login.
JWT_SECRET=replace_with_a_long_random_string
